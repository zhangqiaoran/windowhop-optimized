diff --git a/.github/workflows/build-app.yml b/.github/workflows/build-app.yml
new file mode 100644
index 0000000000000000000000000000000000000000..066dfc856911ebd90f5b0f9ebea62eb27178ca12
--- /dev/null
+++ b/.github/workflows/build-app.yml
@@ -0,0 +1,49 @@
+name: Build WindowHop App
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [main]
+    paths:
+      - 'Sources/**'
+      - 'Tests/**'
+      - 'Support/**'
+      - 'Package.swift'
+      - 'Package.resolved'
+      - 'scripts/package-app.sh'
+      - '.github/workflows/build-app.yml'
+
+permissions:
+  contents: read
+
+jobs:
+  build-app:
+    runs-on: macos-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Swift version
+        run: swift --version
+
+      - name: Tests
+        run: swift test
+
+      - name: Build ad-hoc signed app
+        run: |
+          chmod +x scripts/package-app.sh
+          ./scripts/package-app.sh
+
+      - name: Verify app bundle
+        run: |
+          test -d build/WindowHop.app
+          codesign --verify --deep --strict build/WindowHop.app
+          ls -lh artifacts/
+
+      - name: Upload WindowHop app archive
+        uses: actions/upload-artifact@v4
+        with:
+          name: WindowHop-app
+          path: artifacts/WindowHop-*.zip
+          if-no-files-found: error
+          retention-days: 14
diff --git a/.github/workflows/release-community.yml b/.github/workflows/release-community.yml
new file mode 100644
index 0000000000000000000000000000000000000000..c3e41e016e3c8a707c12faa2859ec0610591a9cb
--- /dev/null
+++ b/.github/workflows/release-community.yml
@@ -0,0 +1,61 @@
+name: Release Community Build
+
+on:
+  push:
+    tags: ["v*.*.*"]
+
+permissions:
+  contents: write
+
+jobs:
+  release:
+    if: github.repository == 'zhangqiaoran/windowhop-optimized'
+    runs-on: macos-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Validate tag version
+        id: version
+        shell: bash
+        run: |
+          VERSION="${GITHUB_REF_NAME#v}"
+          PLIST_VERSION=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' Support/Info.plist)
+          test "$VERSION" = "$PLIST_VERSION" || {
+            echo "Tag $GITHUB_REF_NAME does not match Info.plist version $PLIST_VERSION" >&2
+            exit 1
+          }
+          echo "version=$VERSION" >> "$GITHUB_OUTPUT"
+
+      - name: Tests
+        run: swift test
+
+      - name: Repository validation
+        run: scripts/validate.sh
+
+      - name: Build ad-hoc signed app
+        run: |
+          chmod +x scripts/package-app.sh
+          ./scripts/package-app.sh "${{ steps.version.outputs.version }}"
+          codesign --verify --deep --strict build/WindowHop.app
+
+      - name: Publish GitHub Release
+        env:
+          GH_TOKEN: ${{ github.token }}
+        shell: bash
+        run: |
+          VERSION="${{ steps.version.outputs.version }}"
+          NOTES="RELEASE_NOTES_v${VERSION}.md"
+          if [ -f "$NOTES" ]; then
+            gh release create "$GITHUB_REF_NAME" \
+              "artifacts/WindowHop-${VERSION}.zip" \
+              --title "WindowHop ${VERSION}" \
+              --notes-file "$NOTES"
+          else
+            gh release create "$GITHUB_REF_NAME" \
+              "artifacts/WindowHop-${VERSION}.zip" \
+              --title "WindowHop ${VERSION}" \
+              --generate-notes
+          fi
